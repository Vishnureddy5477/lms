{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets"
              }
            ],
            "styles": [
              "src/styles.css",
              "src/assets/dashboard/vendor/metismenu/css/metisMenu.min.css",
              "src/assets/dashboard/vendor/bootstrap-select/dist/css/bootstrap-select.min.css",
              "src/assets/dashboard/vendor/sweetalert2/dist/sweetalert2.min.css",
              "src/assets/dashboard/vendor/toastr/css/toastr.min.css",
              "src/assets/dashboard/css/style.css",
              "src/assets/dashboard/css/custom.css",
              "src/assets/dashboard/css/icons/material-symbols/material-symbols-outlined.css"
            ],
            "scripts": [
              "src/assets/dashboard/vendor/global/global.min.js",
              "src/assets/dashboard/vendor/metismenu/js/metisMenu.min.js",
              "src/assets/dashboard/vendor/bootstrap-select/dist/js/bootstrap-select.min.js",
              "src/assets/dashboard/vendor/sweetalert2/dist/sweetalert2.min.js",
              "src/assets/dashboard/vendor/toastr/js/toastr.min.js",
              "src/assets/dashboard/js/dlabnav-init.js",
              "src/assets/dashboard/js/custom.min.js"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3.5MB",
                  "maximumError": "5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kB",
                  "maximumError": "40kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200
          },
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "development": {
              "buildTarget": "frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}